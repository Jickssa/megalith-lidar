{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jickssa/megalith-lidar/blob/main/integrations/monolith-france/config/countries/country-profile.schema.json",
  "title": "Monolith Country Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "countryCode",
    "name",
    "status",
    "defaultLocale",
    "supportedLocales",
    "coordinateReferenceSystem",
    "map",
    "atlasEntry",
    "sources",
    "capabilities",
    "licences"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$"
    },
    "name": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "active",
        "community-template",
        "experimental"
      ]
    },
    "defaultLocale": {
      "type": "string"
    },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "coordinateReferenceSystem": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "required": [
        "center",
        "zoom",
        "minZoom",
        "maxZoom",
        "bounds"
      ],
      "properties": {
        "center": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "minZoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "maxZoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "bounds": {
          "type": [
            "array",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "atlasEntry": {
      "type": "string",
      "pattern": "^/assets/web/"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "licences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
